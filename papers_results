': 'TinyLlama/TinyLlama-1.1B-Chat-v1.0'}\nMinimum words/chunk: 200\nHistogram bins: 8-30\n","output_type":"stream"}],"execution_count":2},{"id":"2356557b","cell_type":"markdown","source":"## 1. Load and validate the ZIP\n\nThe input loader prefers `random_papers.zip`. If that exact name is absent, it accepts a single ZIP or a directory containing PDFs. Exact duplicate PDFs are recorded and counted only once. The run stops early if the validated unique-paper count differs from the expected 29.","metadata":{"editable":false}},{"id":"732d9e6f","cell_type":"code","source":"def sha256_file(path, block_size=1024 * 1024):\n    digest = hashlib.sha256()\n    with open(path, \"rb\") as handle:\n        while True:\n            block = handle.read(block_size)\n            if not block:\n                break\n            digest.update(block)\n    return digest.hexdigest()\n\ndef safe_extract_zip(zip_path, destination):\n    destination.mkdir(parents=True, exist_ok=True)\n    with zipfile.ZipFile(zip_path) as archive:\n        bad_member = archive.testzip()\n        if bad_member is not None:\n            raise RuntimeError(f\"ZIP CRC validation failed for member: {bad_member}\")\n        root = destination.resolve()\n        for member in archive.infolist():\n            target = (destination / member.filename).resolve()\n            if target != root and root not in target.parents:\n                raise RuntimeError(f\"Unsafe path found in ZIP: {member.filename}\")\n        archive.extractall(destination)\n\nif not DATASET_ROOT.exists():\n    raise FileNotFoundError(\n        f\"Input root not found: {DATASET_ROOT}. Add the dataset to Kaggle inputs.\"\n    )\n\nzip_paths = sorted(\n    p for p in DATASET_ROOT.rglob(\"*.zip\")\n    if p.is_file()\n)\npreferred_zips = [\n    p for p in zip_paths\n    if p.name.lower() == \"random_papers.zip\"\n]\n\nif EXTRACT_ROOT.exists():\n    shutil.rmtree(EXTRACT_ROOT)\n\nif preferred_zips:\n    if len(preferred_zips) > 1:\n        raise RuntimeError(\n            \"More than one random_papers.zip was found. Keep one copy in Kaggle inputs.\"\n        )\n    selected_zip = preferred_zips[0]\n    safe_extract_zip(selected_zip, EXTRACT_ROOT)\n    PDF_ROOT = EXTRACT_ROOT\n    print(\"Extracted:\", selected_zip)\nelif len(zip_paths) == 1:\n    selected_zip = zip_paths[0]\n    safe_extract_zip(selected_zip, EXTRACT_ROOT)\n    PDF_ROOT = EXTRACT_ROOT\n    print(\"Extracted:\", selected_zip)\nelif len(zip_paths) > 1:\n    raise RuntimeError(\n        \"Multiple ZIP files were found and none is named random_papers.zip. \"\n        \"Rename the intended archive or set the input configuration explicitly.\"\n    )\nelse:\n    PDF_ROOT = DATASET_ROOT\n    print(\"No ZIP found; looking for PDFs directly in the input folders.\")\n\nall_pdf_paths = sorted(\n    (p for p in PDF_ROOT.rglob(\"*.pdf\") if p.is_file()),\n    key=lambda p: (p.name.lower(), str(p).lower())\n)\n\nif not all_pdf_paths:\n    raise FileNotFoundError(\n        f\"No PDF files found under {PDF_ROOT}. Check that random_papers.zip is attached.\"\n    )\n\nmanifest_all_rows = []\nunique_paths = []\nseen_hashes = {}\n\nfor path in all_pdf_paths:\n    file_hash = sha256_file(path)\n    duplicate_of = seen_hashes.get(file_hash, \"\")\n    record = {\n        \"file\": path.name,\n        \"path\": str(path),\n        \"sha256\": file_hash,\n        \"duplicate_of\": duplicate_of,\n        \"pages\": np.nan,\n        \"text_characters\": 0,\n        \"title\": \"\",\n        \"author\": \"\",\n        \"validation_status\": \"\",\n        \"error\": \"\",\n    }\n    if duplicate_of:\n        record[\"validation_status\"] = \"EXACT_DUPLICATE\"\n        manifest_all_rows.append(record)\n        continue\n\n    seen_hashes[file_hash] = path.name\n\n    try:\n        document = fitz.open(str(path))\n        if len(document) < 1:\n            raise ValueError(\"PDF has no pages.\")\n        page_texts = [page.get_text(\"text\") for page in document]\n        text_characters = sum(len(t) for t in page_texts)\n        metadata = dict(document.metadata or {})\n        page_count = len(document)\n        document.close()\n\n        if text_characters < 1000:\n            raise ValueError(\n                f\"Only {text_characters} extractable characters; PDF may be scanned or malformed.\"\n            )\n\n        record.update({\n            \"pages\": page_count,\n            \"text_characters\": text_characters,\n            \"title\": metadata.get(\"title\") or \"\",\n            \"author\": metadata.get(\"author\") or \"\",\n            \"validation_status\": \"VALID\",\n        })\n        unique_paths.append(path)\n    except Exception as exc:\n        record[\"validation_status\"] = \"INVALID\"\n        record[\"error\"] = f\"{type(exc).__name__}: {exc}\"\n    manifest_all_rows.append(record)\n\nmanifest_all_df = pd.DataFrame(manifest_all_rows)\nmanifest_all_df.to_csv(\n    OUTPUT_ROOT / \"input_validation_all_files.csv\",\n    index=False,\n    encoding=\"utf-8-sig\",\n)\n\nvalid_rows = [\n    row for row in manifest_all_rows\n    if row[\"validation_status\"] == \"VALID\"\n]\nunique_pdf_count = len(unique_paths)\n\nprint(\"PDF files discovered:\", len(all_pdf_paths))\nprint(\"Exact duplicate files:\", int((manifest_all_df[\"validation_status\"] == \"EXACT_DUPLICATE\").sum()))\nprint(\"Valid unique papers:\", unique_pdf_count)\nprint(\"Invalid files:\", int((manifest_all_df[\"validation_status\"] == \"INVALID\").sum()))\n\nif STRICT_EXPECTED_PAPER_COUNT and unique_pdf_count != EXPECTED_PAPERS:\n    raise RuntimeError(\n        f\"Expected {EXPECTED_PAPERS} valid unique papers but found {unique_pdf_count}. \"\n        \"Inspect input_validation_all_files.csv before continuing.\"\n    )\n\nif not valid_rows:\n    raise RuntimeError(\"No valid, text-extractable PDFs remain.\")\n\n# Stable paper IDs follow sorted file order.\npaper_records = []\nfor paper_index, path in enumerate(unique_paths, start=1):\n    row = next(r for r in valid_rows if r[\"path\"] == str(path))\n    paper_records.append({\n        \"paper_index\": paper_index,\n        \"paper_id\": f\"P{paper_index:03d}\",\n        \"file\": path.name,\n        \"path\": str(path),\n        \"sha256\": row[\"sha256\"],\n        \"pages\": int(row[\"pages\"]),\n        \"text_characters\": int(row[\"text_characters\"]),\n        \"title\": row[\"title\"],\n        \"author\": row[\"author\"],\n    })\n\npaper_manifest = pd.DataFrame(paper_records)\npaper_manifest.to_csv(\n    OUTPUT_ROOT / \"paper_manifest.csv\",\n    index=False,\n    encoding=\"utf-8-sig\",\n)\ndisplay(paper_manifest[[\"paper_index\", \"paper_id\", \"file\", \"pages\", \"text_characters\", \"title\"]])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:22:10.969652Z","iopub.execute_input":"2026-10-09T17:22:10.970039Z","iopub.status.idle":"2026-10-09T17:22:15.604663Z","shell.execute_reply.started":"2026-10-09T17:22:10.970016Z","shell.execute_reply":"2026-10-09T17:22:15.604015Z"},"editable":false},"outputs":[{"name":"stdout","text":"No ZIP found; looking for PDFs directly in the input folders.\nPDF files discovered: 29\nExact duplicate files: 0\nValid unique papers: 29\nInvalid files: 0\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"    paper_index paper_id                               file  pages  \\\n0             1     P001  1-s2.0-S0022440525001013-main.pdf     24   \n1             2     P002  1-s2.0-S0022440525001189-main.pdf     20   \n2             3     P003  1-s2.0-S0140197121001330-main.pdf     10   \n3             4     P004  1-s2.0-S0140197121001366-main.pdf     12   \n4             5     P005  1-s2.0-S0160738326001635-main.pdf     12   \n5             6     P006  1-s2.0-S0160738326001684-main.pdf      6   \n6             7     P007  1-s2.0-S0190740926000447-main.pdf     15   \n7             8     P008  1-s2.0-S019074092600071X-main.pdf     13   \n8             9     P009  1-s2.0-S0