 f\"{value:.2f}\" if np.isfinite(value) else \"NA\"\n                ax.text(col_index, row_index, label, ha=\"center\", va=\"center\", fontsize=8)\n    fig.colorbar(image, ax=list(axes), shrink=0.82, label=\"Rank correlation\", location=\"right\")\n    fig.suptitle(measure.replace(\"_\", \" \").title())\n    fig.savefig(\n        OUTPUT_ROOT / f\"rank_correlation_{measure}.png\",\n        dpi=180,\n        bbox_inches=\"tight\",\n    )\n    plt.show()\n    plt.close(fig)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:29:50.368635Z","iopub.execute_input":"2026-10-09T17:29:50.369294Z","iopub.status.idle":"2026-10-09T17:29:55.619673Z","shell.execute_reply.started":"2026-10-09T17:29:50.369263Z","shell.execute_reply":"2026-10-09T17:29:55.618932Z"},"editable":false},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1100x450 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":11},{"id":"20e87560","cell_type":"markdown","source":"## 9. Final audit and export\n\nThe final audit verifies that each model has a complete distribution for all 29 papers. The output workbook combines the input manifest, chunk audit, source moments, rankings, correlations, and model status. The CSV files and per-paper 