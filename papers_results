DISPLAY AND EXPORT ALL TABLES AND PLOTS\n# Creates:\n#   1. paper_output_tables.zip\n#   2. paper_output_plots.zip\n# ============================================================\n\nfrom pathlib import Path\nimport zipfile\nimport pandas as pd\nfrom IPython.display import display, Image, SVG, FileLink\n\n# Use the output directory configured earlier in the notebook.\nEXPORT_ROOT = Path(\n    OUTPUT_ROOT if \"OUTPUT_ROOT\" in globals()\n    else \"/kaggle/working/paper_cross_model_robustness\"\n)\nEXPORT_ROOT.mkdir(parents=True, exist_ok=True)\n\nTABLES_ZIP = EXPORT_ROOT / \"paper_output_tables.zip\"\nPLOTS_ZIP = EXPORT_ROOT / \"paper_output_plots.zip\"\n\n# Exclude input-extraction and model-cache directories from output scanning.\nEXCLUDED_DIRS = []\nfor directory_name in (\"EXTRACT_ROOT\", \"HF_CACHE\"):\n    directory = globals().get(directory_name)\n    if directory is not None:\n        EXCLUDED_DIRS.append(Path(directory))\n\n\ndef is_inside(path, parent):\n    \"\"\"Return True if path is parent or is contained within parent.\"\"\"\n    try:\n        path.resolve().relative_to(parent.resolve())\n        return True\n    except ValueError:\n        return False\n\n\ndef is_excluded(path):\n    return any(is_inside(path, directory) for directory in EXCLUDED_DIRS)\n\n\n# ------------------------------------------------------------\n# 1. Find all table files already saved by previous notebook cells\n# ------------------------------------------------------------\n\ntable_extensions = {\".csv\", \".xlsx\"}\n\nsaved_table_files = sorted(\n    path for path in EXPORT_ROOT.rglob(\"*\")\n    if path.is_file()\n    and path.suffix.lower() in table_extensions\n    and not is_excluded(path)\n    and path not in {TABLES_ZIP, PLOTS_ZIP}\n)\n\n# ------------------------------------------------------------\n# 2. Collect the main in-memory result tables, if available\n# ------------------------------------------------------------\n\ntable_variable_names = [\n    \"manifest_all_df\",\n    \"paper_manifest\",\n    \"parse_audit_df\",\n    \"section_audit_df\",\n    \"chunk_audit_df\",\n    \"preflight_df\",\n    \"model_run_df\",\n    \"source_moments_df\",\n    \"ranks_df\",\n    \"pairwise_df\",\n    \"coverage\",\n    \"chunk_scores_df\",\n    \"frequency_distributions_df\",\n]\n\ndataframe_exports = []\nfor variable_name in table_variable_names:\n    obj = globals().get(variable_name)\n    if isinstance(obj, pd.DataFrame):\n        dataframe_exports.append((variable_name, obj))\n\n# Also export both families of correlation matrices.\nmatrix_exports = []\nfor dictionary_name in (\"spearman_matrices\", \"kendall_matrices\"):\n    matrices = globals().get(dictionary_name, {})\n    if isinstance(matrices, dict):\n        for measure, matrix in matrices.items():\n            if isinstance(matrix, pd.DataFrame):\n                matrix_exports.append(\n                    (f\"{dictionary_name}/{measure}.csv\", matrix)\n                )\n\n# Build an inventory of every table included in the tables ZIP.\ninventory_rows = []\n\nfor path in saved_table_files:\n    inventory_rows.append({\n        \"file\": path.relative_to(EXPORT_ROOT).as_posix(),\n        \"type\": \"Previously saved CSV/Excel table\",\n        \"rows\": None,\n        \"columns\": None,\n        \"size_bytes\": path.stat().st_size,\n    })\n\nfor name, df in dataframe_exports:\n    inventory_rows.append({\n        \"file\": f\"dataframe_exports/{name}.csv\",\n        \"type\": \"In-memory DataFrame export\",\n        \"rows\": len(df),\n        \"columns\": len(df.columns),\n        \"size_bytes\": None,\n    })\n\nfor name, df in matrix_exports:\n    inventory_rows.append({\n        \"file\": f\"correlation_matrices/{name}\",\n        \"type\": \"Correlation matrix\",\n        \"rows\": len(df),\n        \"columns\": len(df.columns),\n        \"size_bytes\": None,\n    })\n\ntable_inventory = pd.DataFrame(inventory_rows)\n\n# ------------------------------------------------------------\n# 3. Create the tables ZIP\n#    Includes all saved CSV/XLSX files, individual paper/model\n#    tables, main DataFrames, and correlation matrices.\n# ------------------------------------------------------------\n\nwith zipfile.ZipFile(\n    TABLES_ZIP, mode=\"w\",\n    compression=zipfile.ZIP_DEFLATED,\n    compresslevel=6,\n) as archive:\n\n    # Include every previously saved table file, keeping its folder structure.\n    for path in saved_table_files:\n        archive.write(\n            path,\n            arcname=path.relative_to(EXPORT_ROOT).as_posix(),\n        )\n\n    # Export the consolidated DataFrames explicitly.\n    for name, df in dataframe_exports:\n        archive.writestr(\n            f\"dataframe_exports/{name}.csv\",\n            df.to_csv(index=False).encode(\"utf-8-sig\"),\n        )\n\n    # Export the Spearman and Kendall matrices.\n    for name, matrix in matrix_exports:\n        archive.writestr(\n            f\"correlation_matrices/{name}\",\n            matrix.to_csv(index=True).encode(\"utf-8-sig\"),\n        )\n\n    # Include the archive contents inventory.\n    archive.writestr(\n        \"table_inventory.csv\",\n        table_inventory.to_csv(index=False).encode(\"utf-8-sig\"),\n    )\n\n    archive.writestr(\n        \"README.txt\",\n        (\n            \"TABLE OUTPUTS\\n\"\n            \"This archive contains saved CSV and Excel tables, per-paper/model \"\n            \"tables, consolidated DataFrames, correlation matrices, and an \"\n            \"inventory of the included outputs.\\n\"\n            \"The original folder structure is retained for saved output files.\\n\"\n        ),\n    )\n\n# ------------------------------------------------------------\n# 4. Find all saved plots and create a separate plots ZIP\n# ------------------------------------------------------------\n\nplot_extensions = {\".png\", \".jpg\", \".jpeg\", \".svg\", \".webp\"}\n\nplot_files = sorted(\n    path for path in EXPORT_ROOT.rglob(\"*\")\n    if path.is_file()\n    and path.suffix.lower() in plot_extensions\n    and not is_excluded(path)\n)\n\nwith zipfile.ZipFile(\n    PLOTS_ZIP, mode=\"w\",\n    compression=zipfile.ZIP_DEFLATED,\n    compresslevel=6,\n) as archive:\n\n    for path in plot_files:\n        archive.write(\n            path,\n            arcname=path.relative_to(EXPORT_ROOT).as_posix(),\n        )\n\n    archive.writestr(\n        \"README.txt\",\n        (\n            \"PLOT OUTPUTS\\n\"\n            f\"Number of saved plots included: {len(plot_files)}\\n\"\n            \"Plot files retain their original filenames and relative paths.\\n\"\n        ),\n    )\n\n# ------------------------------------------------------------\n# 5. Display an inventory of all saved table files\n# ------------------------------------------------------------\n\nprint(\"=\" * 72)\nprint(\"TABLE EXPORT\")\nprint(\"=\" * 72)\nprint(\"Saved table files:\", len(saved_table_files))\nprint(\"Consolidated DataFrames exported:\", len(dataframe_exports))\nprint(\"Correlation matrices exported:\", len(matrix_exports))\nprint(\"Tables ZIP:\", TABLES_ZIP)\n\nif not table_inventory.empty:\n    display(table_inventory)\n\n# ------------------------------------------------------------\n# 6. Print/display the main result tables\n#    Large tables show a preview; the ZIP contains the full data.\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"MAIN RESULT TABLES\")\nprint(\"=\" * 72)\n\nfor name, df in dataframe_exports:\n    print(f\"\\n{name} — {len(df):,} rows × {len(df.columns):,} columns\")\n\n    if len(df) <= 60:\n        display(df)\n    else:\n        display(df.head(20))\n        print(\n            f\"Preview shown: 20 of {len(df):,} rows. \"\n            \"The complete table is included in the tables ZIP.\"\n        )\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"CORRELATION MATRICES\")\nprint(\"=\" * 72)\n\nfor name, matrix in matrix_exports:\n    print(f\"\\