R / f\"live_figure_{i:03d}.png\"\n\n    try:\n        fig.savefig(\n            png_path,\n            dpi=200,\n            bbox_inches=\"tight\",\n            facecolor=\"white\"\n        )\n        live_figures_saved += 1\n        print(f\"Saved open figure: {png_path.name}\")\n    except Exception as exc:\n        print(f\"Could not save figure {figure_number}: {exc}\")\n\n# ------------------------------------------------------------\n# 2. Find all saved image and plot files recursively\n# ------------------------------------------------------------\n\nIMAGE_EXTENSIONS = {\n    \".png\", \".jpg\", \".jpeg\", \".svg\", \".webp\",\n    \".gif\", \".bmp\", \".tif\", \".tiff\"\n}\n\nimage_files = sorted(\n    path for path in EXPORT_ROOT.rglob(\"*\")\n    if path.is_file()\n    and path.suffix.lower() in IMAGE_EXTENSIONS\n    and path != ZIP_PATH\n)\n\n# Build a manifest of the files included\nmanifest_rows = []\n\nfor path in image_files:\n    manifest_rows.append({\n        \"file\": path.relative_to(EXPORT_ROOT).as_posix(),\n        \"format\": path.suffix.lower(),\n        \"size_bytes\": path.stat().st_size,\n    })\n\nimage_manifest = pd.DataFrame(\n    manifest_rows,\n    columns=[\"file\", \"format\", \"size_bytes\"]\n)\n\n# ------------------------------------------------------------\n# 3. Package everything into a separate ZIP\n# ------------------------------------------------------------\n\nwith zipfile.ZipFile(\n    ZIP_PATH,\n    mode=\"w\",\n    compression=zipfile.ZIP_DEFLATED,\n    compresslevel=6\n) as archive:\n\n    for path in image_files:\n        archive.write(\n            path,\n            arcname=path.relative_to(EXPORT_ROOT).as_posix()\n        )\n\n    archive.writestr(\n        \"images_manifest.csv\",\n        image_manifest.to_csv(index=False).encode(\"utf-8-sig\")\n    )\n\n    archive.writestr(\n        \"README.txt\",\n        (\n            \"ALL PLOTS AND IMAGES\\n\"\n            f\"Image files included: {len(image_files)}\\n\"\n            f\"Newly saved open Matplotlib figures: {live_figures_saved}\\n\"\n            \"See images_manifest.csv for the list of included files.\\n\"\n        )\n    )\n\n# ------------------------------------------------------------\n# 4. Print the export summary\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"PLOT AND IMAGE EXPORT COMPLETE\")\nprint(\"=\" * 65)\nprint(\"Output directory:\", EXPORT_ROOT)\nprint(\"Open figures saved:\", live_figures_saved)\nprint(\"Total image files in ZIP:\", len(image_files))\nprint(\"ZIP file:\", ZIP_PATH)\nprint(f\"ZIP size: {ZIP_PATH.stat().st_size / (1024**2):.2f} MB\")\n\ndisplay(image_manifest)\ndisplay(FileLink(str(ZIP_PATH)))\n\n# ------------------------------------------------------------\n# 5. Display all found plots and images inline\n# ------------------------------------------------------------\n\nprint(\"\\nDISPLAYING ALL COLLECTED PLOTS AND IMAGES\")\n\nif not image_files:\n    print(\n        \"No saved images were found. Run the plotting cells first, \"\n        \"then rerun this export cell.\"\n    )\nelse:\n    for path in image_files:\n        print(f\"\\n{path.relative_to(EXPORT_ROOT)}\")\n\n        try:\n            if path.suffix.lower() == \".svg\":\n                display(SVG(filename=str(path)))\n            else:\n                display(Image(filename=str(path)))\n        except Exception as exc:\n            print(f\"Could not display this image inline: {exc}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:47:58.555914Z","iopub.execute_input":"2026-10-09T17:47:58.556372Z","iopub.status.idle":"2026-10-09T17:47:58.647437Z","shell.execute_reply.started":"2026-10-09T17:47:58.556343Z","shell.execute_reply":"2026-10-09T17:47:58.646781Z"},"editable":false},"outputs":[{"name":"stdout","text":"\n=================================================================\nPLOT AND IMAGE EXPORT COMPLETE\n==========================