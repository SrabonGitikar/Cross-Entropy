\\b\",\n    r\"^acknowledg(?:e)?ments?\\b\",\n    r\"^credit authorship contribution statement\\b\",\n    r\"^declaration of competing interest\\b\",\n    r\"^declaration of interests\\b\",\n    r\"^data availability\\b\",\n    r\"^funding(?: statement)?\\b\",\n    r\"^supplementary (?:data|material)\\b\",\n    r\"^appendix\\b\",\n    r\"^author contributions?\\b\",\n    r\"^conflict of interest\\b\",\n    r\"^CRediT authorship contribution statement\\b\",\n]\nEND_HEADING_RX = [re.compile(p, re.I) for p in END_SECTION_PATTERNS]\n\nCOMMON_HEADINGS = {\n    \"abstract\", \"introduction\", \"background\", \"theoretical background\",\n    \"literature review\", \"method\", \"methods\", \"methodology\",\n    \"materials and methods\", \"results\", \"findings\", \"discussion\",\n    \"general discussion\", \"discussion and conclusion\", \"conclusion\",\n    \"conclusions\", \"limitations\", \"strengths & limitations\",\n    \"current study\", \"the present study\", \"research methodology\",\n    \"theoretical framework\", \"conceptual background\", \"recommendations\",\n    \"implications\", \"future research\", \"participants\", \"measures\",\n    \"procedure\", \"data analysis\", \"study design\", \"statistical analysis\",\n    \"results and discussion\", \"general method\", \"research design\",\n    \"method and materials\", \"methodology and data\", \"concluding remarks\",\n}\n\ndef normalize_text(text):\n    return re.sub(r\"\\s+\", \" \", text.replace(\"\\xad\", \"\")).strip()\n\ndef count_words(text):\n    return len(WORD_RE.findall(text))\n\ndef block_to_info(block):\n    if block.get(\"type\") != 0:\n        return None\n\n    spans_all = []\n    line_texts = []\n    for line in block.get(\"lines\", []):\n        spans = [\n            span for span in line.get(\"spans\", [])\n            if span.get(\"text\", \"\").strip()\n        ]\n        if not spans:\n            continue\n        spans.sort(key=lambda span: span[\"bbox\"][0])\n        output = \"\"\n        previous = None\n        for span in spans:\n            value = span[\"text\"]\n            if previous is not None:\n                gap = span[\"bbox\"][0] - previous[\"bbox\"][2]\n                threshold = max(1.2, 0.22 * float(span.get(\"size\", 9)))\n                if gap > threshold and output and not output.endswith((\" \", \"\\n\")) and not value.startswith((\" \", \"\\n\")):\n                    output += \" \"\n            output += value\n            previous = span\n            spans_all.append(span)\n\n        text_line = normalize_text(output)\n        if text_line:\n            line_texts.append(text_line)\n\n    text = normalize_text(\" \".join(line_texts))\n    if not text or not spans_all:\n        return None\n\n    return {\n        \"text\": text,\n        \"x0\": min(span[\"bbox\"][0] for span in spans_all),\n        \"y0\": min(span[\"bbox\"][1] for span in spans_all),\n        \"x1\": max(span[\"bbox\"][2] for span in spans_all),\n        \"y1\": max(span[\"bbox\"][3] for span in spans_all),\n        \"font\": float(np.median([float(span.get(\"size\", 9.0)) for span in spans_all])),\n        \"bold\": any(\n            (\"bold\" in span.get(\"font\", \"\").lower()\n             or \"semibold\" in span.get(\"font\", \"\").lower())\n            for span in spans_all\n        ),\n    }\n\ndef page_blocks_reading_order(page):\n    infos = []\n    for block in page.get_text(\"dict\").get(\"blocks\", []):\n        info = block_to_info(block)\n        if info is not None:\n            infos.append(info)\n\n    if not infos:\n        return []\n\n    width = page.rect.width\n    height = page.rect.height\n    infos = [\n        block for block in infos\n        if block[\"y0\"] >= HEADER_FRACTION * height\n        and block[\"y1\"] <= (1.0 - FOOTER_FRACTION) * height\n    ]\n    if not infos:\n        return []\n\n    left, right, full = [], [], []\n    for block in infos:\n        if block[\"x0\"] < 0.06 * width and block[\"x1\"] > 0.94 * width:\n            full.append(block)\n        elif (block[\"x0\"] + block[\"x1\"]) / 2 < width / 2:\n            left.append(block)\n        else:\n            right.append(block)\n\n    if left and right:\n        columns = (\n            sorted(left, key=lambda item: (item[\"y0\"], item[\"x0\"]))\n            + sorted(right, key=lambda item: (item[\"y0\"], item[\"x0\"]))\n        )\n        first_column_y = min(item[\"y0\"] for item in left + right)\n        full_top = sorted(\n            [item for item in full if item[\"y0\"] <= first_column_y + 5],\n            key=lambda item: item[\"y0\"],\n        )\n        full_rest = sorted(\n            [item for item in full if item[\"y0\"] > first_column_y + 5],\n            key=lambda item: item[\"y0\"],\n        )\n        return full_top + columns + full_rest\n\n    return sorted(infos, key=lambda item: (item[\"y0\"], item[\"x0\"]))\n\ndef is_end_heading(text):\n    return any(pattern.match(text) for pattern in END_HEADING_RX)\n\ndef is_standalone_equation(text):\n    if len(text) < 8:\n        return False\n    words = count_words(text)\n    letters = sum(char.isalpha() for char in text)\n    symbols = sum(\n        not (char.isalnum() or char.isspace() or char in \".,;:'’()-[]\")\n        for char in text\n    )\n    return (\n        words < 12\n        and letters / max(len(text), 1) < 0.35\n        and symbols / max(len(text), 1) > 0.12\n    )\n\ndef is_heading(block):\n    text = block[\"text\"]\n    lowered = text.lower().rstrip(\":\")\n    if len(text) > 180 or CAPTION_RE.match(text):\n        return False\n    if NUMBERED_HEADING_RE.match(text):\n        return True\n    if lowered in COMMON_HEADINGS:\n        return True\n    return (\n        block[\"bold\"]\n        and block[\"font\"] >= 7.5\n        and not text.endswith((\".\", \",\", \";\", \"?\", \"!\"))\n        and count_words(text) <= 18\n    )\n\ndef extract_paper_sections(pdf_path):\n    document = fitz.open(str(pdf_path))\n    page_blocks = []\n    short_text_frequency = collections.Counter()\n\n    for page_number, page in enumerate(document, start=1):\n        blocks = page_blocks_reading_order(page)\n        for block in blocks:\n            block[\"page\"] = page_number\n            if len(block[\"text\"]) <= 120:\n                short_text_frequency[block[\"text\"].lower()] += 1\n        page_blocks.append(blocks)\n\n    page_count = len(page_blocks)\n    document.close()\n\n    repeated_short_text = {\n        text for text, count in short_text_frequency.items()\n        if count >= max(3, int(0.5 * page_count))\n    }\n\n    sections = []\n    current = None\n    started = False\n\n    for blocks in page_blocks:\n        for block in blocks:\n            text = normalize_text(block[\"text\"])\n            lowered = text.lower()\n            if not text or PAGE_NUMBER_RE.fullmatch(text):\n                continue\n            if block[\"font\"] < 7.0:\n                continue\n            if CAPTION_RE.match(text):\n                continue\n            if re.search(r\"\\.{4,}\\s*\\d+\\s*$\", text):\n                continue\n            if lowered in repeated_short_text and len(text) < 120:\n                continue\n            if is_end_heading(text):\n                return sections\n            if lowered.startswith((\"keywords\", \"key words\")):\n                continue\n\n            heading = is_heading(block)\n            if heading:\n                if not started:\n                    if (\n                        NUMBERED_HEADING_RE.match(text)\n                        or lowered in {\n                            \"abstract\", \"introduction\", \"background\",\n                            \"method\", \"methods\", \"methodology\",\n                            \"materials and methods\", \"text\",\n                        }\n                        or (block[\"bold\"] and block[\"font\"] >= 7.5 and block[\"page\"] >= 2)\n                    ):\n                        started = True\n                    else:\n                        continue\n\n                current = {\n                    \"heading\": text,\n                    \"page\": block[\"page\"],\n                    \"paragraphs\": [],\n                }\n                sections.append(current)\n                continue\n\n            if not started or is_standalone_equation(text):\n                continue\n            if count_words(text) < 5 and block[\"font\"] < 8.5:\n                continue\n            if current is None:\n                current = {\n                    \"heading\": \"Unlabelled text\",\n                    \"page\": block[\"page\"],\n                    \"paragraphs\": [],\n                }\n                sections.append(current)\n            current[\"paragraphs\"].append({\n                \"text\": text,\n                \"page\": block[\"page\"],\n            })\n\n    return sections\n\ndef create_paper_chunks(sections, min_words=MIN_WORDS):\n    chunks = []\n    section_audit = []\n\n    for section_index, section in enumerate(sections, start=1):\n        paragraphs = [\n            paragraph for paragraph in section[\"paragraphs\"]\n            if count_words(paragraph[\"text\"]) > 0\n        ]\n        if not paragraphs:\n            continue\n\n        subsection_words = sum(count_words(p[\"text\"]) for p in paragraphs)\n        section_audit.append({\n            \"section_index\": section_index,\n            \"section_heading\": section[\"heading\"],\n            \"start_page\": section[\"page\"],\n            \"paragraph_count\": len(paragraphs),\n            \"word_count\": subsection_words,\n        })\n\n        if subsection_words < min_words:\n            chunks.append({\n                \"section_index\": section_index,\n                \"section_heading\": section[\"heading\"],\n                \"paragraph_start\": 1,\n                \"paragraph_end\": len(paragraphs),\n                \"paragraph_count\": len(paragraphs),\n                \"subsection_word_count\": subsection_words,\n                \"short_subsection_exception\": True,\n                \"word_count\": subsection_words,\n                \"start_page\": paragraphs[0][\"page\"],\n                \"end_page\": paragraphs[-1][\"page\"],\n                \"text\": \"\\n\\n\".join(p[\"text\"] for p in paragraphs),\n            })\n            continue\n\n        current, current_words, section_chunks = [], 0, []\n        for paragraph_index, paragraph in enumerate(paragraphs, start=1):\n            current.append(paragraph)\n            current_words += count_words(paragraph[\"text\"])\n            if current_words >= min_words:\n                section_chunks.append({\n                    \"section_index\": section_index,\n                    \"section_heading\": section[\"heading\"],\n                    \"paragraph_start\": paragraph_index - len(current) + 1,\n                    \"paragraph_end\": paragraph_index,\n                    \"paragraph_count\": len(current),\n                    \"subsection_word_count\": subsection_words,\n                    \"short_subsection_exception\": False,\n                    \"word_count\": current_words,\n                    \"start_page\": current[0][\"page\"],\n                    \"end_page\": current[-1][\"page\"],\n                    \"text\": \"\\n\\n\".join(p[\"text\"] for p in current),\n                })\n                current, current_words = [], 0\n\n        if current:\n            remainder_text = \"\\n\\n\".join(p[\"text\"] for p in current)\n            if section_chunks:\n                previous = section_chunks[-1]\n                previous[\"paragraph_end\"] = len(paragraphs)\n                previous[\"paragraph_count\"] += len(current)\n                previous[\"word_count\"] += current_words\n                previous[\"end_page\"] = current[-1][\"page\"]\n                previous[\"text\"] += \"\\n\\n\" + remainder_text\n            else:\n                section_chunks.append({\n                    \"section_index\": section_index,\n                    \"section_heading\": section[\"heading\"],\n                    \"paragraph_start\": 1,\n                    \"paragraph_end\": len(paragraphs),\n                    \"paragraph_count\": len(paragraphs),\n                    \"subsection_word_count\": subsection_words,\n                    \"short_subsection_exception\": False,\n                    \"word_count\": current_words,\n                    \"start_page\": current[0][\"page\"],\n                    \"end_page\": current[-1][\"page\"],\n                    \"text\": remainder_text,\n                })\n\n        chunks.extend(section_chunks)\n\n    for chunk_id, chunk in enumerate(chunks, start=1):\n        chunk[\"chunk_id\"] = chunk_id\n\n    return chunks, section_audit","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:22:44.483048Z","iopub.execute_input":"2026-10-09T17:22:44.483488Z","iopub.status.idle":"2026-10-09T17:22:44.522925Z","shell.execute_reply.started":"2026-10-09T17:22:44.483459Z","shell.execute_reply":"2026-10-09T17:22:44.522211Z"},"editable":false},"outputs":[],"execution_count":4},{"id":"0920e999","cell_type":"markdown","source":"## 3. Audit the reconstructed paper chunks\n\nThis cell reconstructs each paper once, creates the same chunk text that will be passed to every model, and validates the 200-word rules before any model scoring begins.","metadata":{"editable":false}},{"id":"38c1a118","cell_type":"code","source":"paper_chunks = {}\nsection_audit_rows = []\nchunk_audit_rows = []\nparse_audit_rows = []\n\nfor paper in paper_records:\n    paper_id = paper[\"paper_id\"]\n    pdf_path = Path(paper[\"path\"])\n\n    try:\n        sections = extract_paper_sections(pdf_path)\n        chunks, sections_audit = create_paper_chunks(sections, MIN_WORDS)\n\n        if not sections:\n            raise RuntimeError(\"No article sections could be detected.\")\n        if not chunks:\n            raise RuntimeError(\"No chunks could be created.\")\n\n        section_to_chunks = collections.Counter(\n            chunk[\"section_index\"] for chunk in chunks\n        )\n\n        for section_row in sections_audit:\n            section_audit_rows.append({\n                \"paper_id\": paper_id,\n                \"paper_file\": paper[\"file\"],\n                **section_row,\n                \"chunks_in_section\": section_to_chunks[section_row[\"section_index\"]],\n            })\n\n        for chunk in chunks:\n            if chunk[\"word_count\"] < MIN_WORDS and not chunk[\"short_subsection_exception\"]:\n                raise AssertionError(\n                    f\"{paper_id}, chunk {chunk['chunk_id']} is below {MIN_WORDS} words \"\n                    \"without the short-subsection exception.\"\n                )\n            if chunk[\"short_subsection_exception\"] and chunk[\"word_count\"] != chunk[\"subsection_word_count\"]:\n                raise AssertionError(\n                    f\"{paper_id}, chunk {chunk['chunk_id']} does not contain the full short subsection.\"\n                )\n\n            chunk_audit_rows.append({\n                \"paper_id\": paper_id,\n                \"paper_file\": paper[\"file\"],\n                \"chunk_id\": chunk[\"chunk_id\"],\n                \"section_index\": chunk[\"section_index\"],\n                \"section_heading\": chunk[\"section_heading\"],\n                \"paragraph_start\": chunk[\"paragraph_start\"],\n                \"paragraph_end\": chunk[\"paragraph_end\"],\n                \"paragraph_count\": chunk[\"paragraph_count\"],\n                \"start_page\": chunk[\"start_page\"],\n                \"end_page\": chunk[\"end_page\"],\n                \"word_count\": chunk[\"word_count\"],\n                \"subsection_word_count\": chunk[\"subsection_word_count\"],\n                \"short_subsection_exception\": chunk[\"short_subsection_exception\"],\n            })\n\n        chunk_signature_payload = \"\\\\n\".join(\n            f\"{chunk['chunk_id']}|{chunk['section_index']}|{chunk['word_count']}|\"\n            f\"{hashlib.sha256(chunk['text'].encode('utf-8')).hexdigest()}\"\n            for chunk in chunks\n        )\n        chunk_signature = hashlib.sha256(\n            chunk_signature_payload.encode(\"utf-8\")\n        ).hexdigest()\n\n        paper_chunks[paper_id] = {\n            \"paper\": paper,\n            \"sections\": sections,\n            \"chunks\": chunks,\n            \"chunk_signature\": chunk_signature,\n        }\n\n        total_words = sum(chunk[\"word_count\"] for chunk in chunks)\n        parse_audit_rows.append({\n            \"paper_id\": paper_id,\n            \"paper_file\": paper[\"file\"],\n            \"sections_detected\": len(sections_audit),\n            \"chunks_created\": len(chunks),\n            \"total_chunk_words\": total_words,\n            \"short_subsection_chunks\": sum(\n                bool(chunk[\"short_subsection_exception\"]) for chunk in chunks\n            ),\n            \"status\": \"SUCCESS\",\n            \"error\": \"\",\n        })\n        print(\n            f\"{paper_id} | {paper['file']} | \"\n            f\"{len(sections_audit)} sections | {len(chunks)} chunks | {total_words:,} words\"\n        )\n\n    except Exception as exc:\n        parse_audit_rows.append({\n            \"paper_id\": paper_id,\n            \"paper_file\": paper[\"file\"],\n            \"sections_detected\": 0,\n            \"chunks_created\": 0,\n            \"total_chunk_words\": 0,\n            \"short_subsection_chunks\": 0,\n            \"status\": \"FAILED\",\n            \"error\": f\"{type(exc).__name__}: {exc}\",\n        })\n\nparse_audit_df = pd.DataFrame(parse_audit_rows)\nsection_audit_df = pd.DataFrame(section_audit_rows)\nchunk_audit_df = pd.DataFrame(chunk_audit_rows)\n\nparse_audit_df.to_csv(OUTPUT_ROOT / \"paper_extraction_audit.csv\", index=False, encoding=\"utf-8-sig\")\nsection_audit_df.to_csv(OUTPUT_ROOT / \"section_audit.csv\", index=False, encoding=\"utf-8-sig\")\nchunk_audit_df.to_csv(OUTPUT_ROOT / \"chunk_definition_audit.csv\", index=False, encoding=\"utf-8-sig\")\n\nfailed_parses = parse_audit_df[parse_audit_df[\"status\"] != \"SUCCESS\"]\nif not failed_parses.empty:\n    display(failed_parses)\n    raise RuntimeError(\n        f\"Text extraction/chunking failed for {len(failed_parses)} paper(s). \"\n        \"Inspect paper_extraction_audit.csv and section_audit.csv before scoring.\"\n    )\n\nif len(paper_chunks) != EXPECTED_PAPERS:\n    raise RuntimeError(\n        f\"Expected chunks for {EXPECTED_PAPERS} papers but prepared {len(paper_chunks)}.\"\n    )\n\nprint(\"\\nChunking checks passed for all papers.\")\ndisplay(parse_audit_df[[\"paper_id\", \"paper_file\", \"sections_detected\", \"chunks_created\", \"short_subsection_chunks\"]])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:22:50.868526Z","iopub.execute_input":"2026-10-09T17:22:50.869281Z","iopub.status.idle":"2026-10-09T17:22:57.204065Z","shell.execute_reply.started":"2026-10-09T17:22:50.869248Z","shell.execute_reply":"2026-10-09T17:22:57.203377Z"},"editable":false},"outputs":[{"name":"stdout","text":"P001 | 1-s2.0-S0022440525001013-main.pdf | 13 sections | 41 chunks | 12,951 words\nP002 | 1-s2.0-S0022440525001189-main.pdf | 14 sections | 39 chunks | 12,418 words\nP003 | 1-s2.0-S0140197121001330-main.pdf | 5 sections | 16 chunks | 4,704 words\nP004 | 1-s2.0-S0140197121001366-main.pdf | 7 sections | 23 chunks | 6,908 words\nP005 | 1-s2.0-S0160738326001635-main.pdf | 6 sections | 23 chunks | 7,100 words\nP006 | 1-s2.0-S0160738326001684-main.pdf | 2 sections | 5 chunks | 1,859 words\nP007 | 1-s2.0-S0190740926000447-main.pdf | 21 sections | 50 chunks | 13,870 words\nP008 | 1-s2.0-S019074092600071X-main.pdf | 21 sections | 37 chunks | 9,535 words\nP009 | 1-s2.0-S0195666326003582-main.pdf | 22 sections | 25 chunks | 7,100 words\nP010 | 1-s2.0-S0195666326003594-m