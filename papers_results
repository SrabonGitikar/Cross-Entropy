rust_remote_code=False,\n        )\n        model = AutoModelForCausalLM.from_pretrained(\n            model_name,\n            cache_dir=str(HF_CACHE),\n            torch_dtype=MODEL_DTYPE,\n            low_cpu_mem_usage=True,\n            trust_remote_code=False,\n        )\n        model.to(DEVICE)\n        model.eval()\n        context_length = get_context_length(tokenizer, model)\n        model_revision = getattr(model.config, \"_commit_hash\", \"\") or \"\"\n\n        test = tokenizer(\n            \"This is a short language-model scoring check.\",\n            return_tensors=\"pt\",\n            add_special_tokens=False,\n        )\n        input_ids = test[\"input_ids\"].to(DEVICE)\n        if input_ids.shape[1] < 2:\n            raise RuntimeError(\"Tokenizer returned fewer than two test tokens.\")\n\n        with torch.inference_mode():\n            logits = model(input_ids).logits\n\n        if logits.ndim != 3 or logits.shape[:2] != input_ids.shape:\n            raise RuntimeError(f\"Unexpected model-logit shape: {tuple(logits.shape)}\")\n\n        preflight_rows.append({\n            \"model_key\": model_key,\n            \"model_name\": model_name,\n            \"status\": \"SUCCESS\",\n            \"context_length\": context_length,\n            \"model_revision\": model_revision,\n            \"error\": \"\",\n        })\n        print(f\"  OK | context={context_length} | device={DEVICE}\")\n\n    except Exception as exc:\n        preflight_rows.append({\n            \"model_key\": model_key,\n            \"model_name\": model_name,\n            \"status\": \"FAILED\",\n            \"context_length\": np.nan,\n            \"model_revision\": \"\",\n            \"error\": f\"{type(exc).__name__}: {exc}\",\n        })\n        print(f\"  FAILED | {type(exc).__name__}: {exc}\")\n\n    finally:\n        if model is not None:\n            del model\n        if tokenizer is not None:\n            del tokenizer\n        gc.collect()\n        if torch.cuda.is_available():\n            torch.cuda.empty_cache()\n\npreflight_df = pd.DataFrame(preflight_rows)\npreflight_df.to_csv(\n    OUTPUT_ROOT / \"model_preflight_status.csv\",\n    index=False,\n    encoding=\"utf-8-sig\",\n)\ndisplay(preflight_df)\n\nfailed_models = preflight_df[preflight_df[\"status\"] != \"SUCCESS\"]\nif not failed_models.empty:\n    raise RuntimeError(\n        \"One or more model checkpoints failed preflight. No full scoring pass was started. \"\n        \"Enable Internet in Kaggle or add the public model checkpoints to Kaggle inputs, then rerun. \"\n        \"See model_preflight_status.csv for the checkpoint-level errors.\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:23:01.799128Z","iopub.execute_input":"2026-10-09T17:23:01.799513Z","iopub.status.idle":"2026-10-09T17:23:54.762553Z","shell.execute_reply.started":"2026-10-09T17:23:01.799486Z","shell.execute_reply":"2026-10-09T17:23:54.761803Z"},"editable":false},"outputs":[{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"name":"stdout","text":"Checking gpt2: gpt2\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/665 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f9d690eb32ef46448b3cdbebd7ada62d"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/26.0 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"2a671b9f8d6a4c638fa28c258f707648"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.json:   0%|          | 0.00/1.04M [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"4a931690cdf04b778ad72295c08a73