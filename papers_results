\n    )\n\n    ax.set_title(\n        f\"Spearman's Rank Correlation (rho)\\n\"\n        f\"{measure.replace('_', ' ').title()}\"\n    )\n\n    ax.set_xlabel(\"Language model\")\n    ax.set_ylabel(\"Language model\")\n\n    # Annotate each correlation coefficient\n    for i in range(matrix.shape[0]):\n        for j in range(matrix.shape[1]):\n            value = matrix.iloc[i, j]\n            label = f\"{value:.2f}\" if np.isfinite(value) else \"NA\"\n            ax.text(\n                j, i, label,\n                ha=\"center\",\n                va=\"center\",\n                fontsize=9\n            )\n\n    fig.colorbar(image, ax=ax, label=\"Spearman's rho\")\n    fig.tight_layout()\n\n    safe_measure = \"\".join(\n        ch if ch.isalnum() or ch in \"-_\" else \"_\"\n        for ch in measure\n    )\n    plot_path = SPEARMAN_DIR / f\"spearman_rho_{safe_measure}.png\"\n\n    fig.savefig(\n        plot_path,\n        dpi=200,\n        bbox_inches=\"tight\"\n    )\n\n    display(Image(filename=str(plot_path)))\n    plt.close(fig)\n\n    plot_files.append(plot_path)\n\n# Create ZIP containing only Spearman plots\nwith zipfile.ZipFile(\n    ZIP_PATH,\n    mode=\"w\",\n    compression=zipfile.ZIP_DEFLATED\n) as archive:\n    for plot_path in plot_files:\n        archive.write(plot_path, arcname=plot_path.name)\n\nprint(\"=\" * 60)\nprint(\"SPEARMAN PLOTS EXPORT COMPLETE\")\nprint(\"=\" * 60)\nprint(f\"Spearman plots generated: {len(plot_files)}\")\nprint(f\"Plot folder: {SPEARMAN_DIR}\")\nprint(f\"ZIP archive: {ZIP_PATH}\")\nprint(f\"ZIP size: {ZIP_PATH.stat().st_size / 1024:.1f} KB\")\n\ndisplay(FileLink(str(ZIP_PATH)))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T18:01:34.936284Z","iopub.execute_input":"2026-10-09T18:01:34.936725Z","iopub.status.idle":"2026-10-09T18:01:37.209589Z","shell.execute_reply.started":"2026-10-09T18:01:34.936695Z","shell.execute_reply":"2026-10-09T18:01:37.208957Z"},"editable":false},"outputs":[{"output_type