ESS</td>\n      <td>23</td>\n      <td>7</td>\n      <td>1.015188</td>\n      <td>0.002894</td>\n      <td>0.053796</td>\n      <td>-0.000136</td>\n      <td>0.000027</td>\n      <td>-0.876307</td>\n      <td>0.197838</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":9},{"id":"2322a06c","cell_type":"markdown","source":"## 7. Rank correlations between models\n\nFor each source-level measure, models are compared using Spearman's rank correlation and Kendall's tau-b across the same set of papers. Correlation matrices, pairwise coefficients, p-values, and within-measure Benjamini--Hochberg adjusted p-values are saved. Rankings are also exported directly for inspection.","metadata":{"editable":false}},{"id":"eb3abceb","cell_type":"code","source":"from scipy.stats import spearmanr, kendalltau\n\nMEASURES = [\n    \"mean_bpc\",\n    \"sd_bpc\",\n    \"variance_bpc\",\n    \"third_central_moment_bpc\",\n    \"fourth_central_moment_bpc\",\n    \"skewness_bpc\",\n    \"excess_kurtosis_bpc\",\n]\n\nmodel_order = list(MODEL_NAMES.keys())\nvalid_moments = source_moments_df[\n    source_moments_df[\"status\"].eq(\"SUCCESS\")\n].copy()\n\ndef benjamini_hochberg(p_values):\n    p_values = np.asarray(p_values, dtype=float)\n    adjusted = np.full(p_values.shape, np.nan, dtype=float)\n    valid = np.isfinite(p_values)\n    if not np.any(valid):\n        return adjusted\n    p = p_values[valid]\n    order = np.argsort(p)\n    sorted_p = p[order]\n    n = len(sorted_p)\n    sorted_q = sorted_p * n / np.arange(1, n + 1)\n    sorted_q = np.minimum.accumulate(sorted_q[::-1])[::-1]\n    sorted_q = np.clip(sorted_q, 0, 1)\n    q = np.empty_like(sorted_q)\n    q[order] = sorted_q\n    adjusted[valid] = q\n    return adjusted\n\npairwise_rows = []\nspearman_matrices = {}\nkendall_matrices = {}\nrank_rows = []\n\nfor measure in MEASURES:\n    wide = valid_moments.pivot_table(\n        index=[\"paper_id\", \"paper_index\", \"paper_file\"],\n        columns=\"model_key\",\n        values=measure,\n        aggfunc=\"first\",\n    )\n\n    rho_matrix = pd.DataFrame(np.nan, index=model_order, columns=model_order)\n    tau_matrix = pd.DataFrame(np.nan, index=model_order, columns=model_order)\n\n    for model_key in model_order:\n        if model_key in wide.columns:\n            rho_matrix.loc[model_key, model_key] = 1.0\n            tau_matrix.loc[model_key, model_key] = 1.0\n\n            for idx, row in valid_moments[valid_moments[\"model_key\"] == model_key].iterrows():\n                value = row[measure]\n                if pd.notna(value):\n                    # Rank 1 denotes the smallest value for this measure.\n                    rank_rows.append({\n                        \"measure\": measure,\n                        \"model_key\": model_key,\n                        \"paper_id\": row[\"paper_id\"],\n                        \"paper_index\": row[\"paper_index\"],\n                        \"paper_file\": row[\"paper_file\"],\n                        \"value\": value,\n                    })\n\n    for i, model_1 in enumerate(model_order):\n        for model_2 in model_order[i + 1:]:\n            if model_1 not in wide.columns or model_2 not in wide.columns:\n                continue\n\n            paired = wide[[model_1, model_2]].dropna()\n            n_papers = len(paired)\n\n            if (\n                n_papers >= 3\n                and paired[model_1].nunique() > 1\n                and paired[model_2].nunique() > 1\n            ):\n                sr = spearmanr(paired[model_1], paired[model_2])\n                kt = kendalltau(paired[model_1], paired[model_2], variant=\"b\")\n                rho, rho_p = float(sr.statistic), float(sr.pvalue)\n                tau, tau_p = float(kt.statistic), float(kt.pvalue)\n            else:\n                rho = rho_p = tau = tau_p = np.nan\n\n            rho_matrix.loc[model_1, model_2] = rho\n            rho_matrix.loc[model_2, model_1] = rho\n            tau_matrix.loc[model_1, model_2] = tau\n            tau_matrix.loc[model_2, model_1] = tau\n\n            pairwise_rows.append({\n                \"measure\": measure,\n                \"model_1\": model_1,\n                \"model_2\": model_2,\n                \"n_papers\": n_papers,\n                \"spearman_rho\": rho,\n                \"spearman_pvalue\": rho_p,\n                \"kendall_tau_b\": tau,\n                \"kendall_pvalue\": tau_p,\n            })\n\n    spearman_matrices[measure] = rho_matrix\n    kendall_matrices[measure] = tau_matrix\n    rho_matrix.to_csv(OUTPUT_ROOT / f\"spearman_matrix_{measure}.csv\", encoding=\"utf-8-sig\")\n    tau_matrix.to_csv(OUTPUT_ROOT / f\"kendall_matrix_{measure}.csv\", encoding=\"utf-8-sig\")\n\npairwise_df = pd.DataFrame(pairwise_rows)\nif not pairwise_df.empty:\n    pairwise_df[\"spearman_q_within_measure\"] = np.nan\n    pairwise_df[\"kendall_q_within_measure\"] = np.nan\n    for measure in pairwise_df[\"measure\"].unique():\n        mask = pairwise_df[\"measure\"].eq(measure)\n        pairwise_df.loc[mask, \"spearman_q_within_measure\"] = benjamini_hochberg(\n            pairwise_df.loc[mask, \"spearman_pvalue\"].to_numpy()\n        )\n        pairwise_df.loc[mask, \"kendall_q_within_measure\"] = benjamini_hochberg(\n            pairwise_df.loc[mask, \"kendall_pvalue\"].to_numpy()\n        )\n\npairwise_df.to_csv(\n    OUTPUT_ROOT / \"pairwise_rank_correlations.csv\",\n    index=False,\n    encoding=\"utf-8-sig\",\n)\n\nranks_df = pd.DataFrame(rank_rows)\nranks_df[\"rank\"] = ranks_df.groupby([\"measure\", \"model_key\"])[\"value\"].rank(\n    method=\"average\", ascending=True\n)\nranks_df.to_csv(\n    OUTPUT_ROOT / \"paper_rankings_by_model.csv\",\n    index=False,\n    encoding=\"utf-8-sig\",\n)\n\nprint(\"Pairwise rank correlations:\")\ndisplay(pairwise_df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T17:29:43.351359Z","iopub.execute_input":"2026-10-09T17:29:43.352159Z","iopub.status.idl